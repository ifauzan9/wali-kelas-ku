# Salin file ini menjadi .env lalu isi nilainya.
# Jalankan: cp .env.example .env  (Windows: copy .env.example .env)

# Wajib — connection string Neon PostgreSQL (pakai endpoint pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Opsional — Neon Object Storage (S3-compatible), dipakai fitur upload foto catatan.
NEON_STORAGE_BUCKET=catatan-siswa
AWS_ENDPOINT_URL_S3=https://xxx.storage.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Port server API (default 3001). Tidak dipakai di Vercel.
PORT=3001

# Untuk deploy Vercel: isi variabel di atas (kecuali PORT) pada
# Project Settings -> Environment Variables (Production + Preview).
